{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutation-forge.invalid/schemas/native-v3-program-batch.json",
  "title": "Mutation Forge Native v3 provider batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "programs"],
  "properties": {
    "schema_version": {"type": "string", "const": "mforge.native.program_batch.v3"},
    "programs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "program_json_raw", "design_summary"],
        "properties": {
          "slot_id": {"type": "string", "pattern": "^slot-0[0-7]$"},
          "program_json_raw": {"type": "string", "minLength": 1, "maxLength": 32768},
          "design_summary": {"type": "string", "minLength": 1, "maxLength": 2048}
        }
      }
    }
  }
}
