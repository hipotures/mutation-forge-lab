{
  "schema_version": "mforge.native.baseline_rankers.v2",
  "rankers": [
    {
      "policy_id": "native_random",
      "kind": "deterministic_hash",
      "description": "Stable ordering by SHA-256 of the canonical proposal payload.",
      "signals": ["canonical_proposal_hash"],
      "oracle_access": false
    },
    {
      "policy_id": "native_structural",
      "kind": "bounded_linear",
      "description": "Prefer sampled broken witnesses and remote reconnections while penalising local triangle and C4 risk.",
      "signals": [
        "broken_sampled_witnesses_by_length",
        "mean_preexisting_distance_for_new_edges",
        "local_triangle_risk",
        "local_c4_risk"
      ],
      "weights": {
        "broken_sampled_witnesses_by_length": 1.0,
        "mean_preexisting_distance_for_new_edges": 0.25,
        "local_triangle_risk": -0.25,
        "local_c4_risk": -0.25
      },
      "oracle_access": false
    }
  ]
}
