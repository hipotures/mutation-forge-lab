{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutation-forge.invalid/schemas/native-context.v1.json",
  "title": "Mutation Forge native ranker context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "order", "step", "remaining_steps", "stagnation", "recent_acceptance_rate"],
  "properties": {
    "schema_version": {"const": "mforge.native.context.v1"},
    "order": {"type": "integer", "minimum": 4},
    "step": {"type": "integer", "minimum": 0},
    "remaining_steps": {"type": "integer", "minimum": 0},
    "stagnation": {"type": "integer", "minimum": 0},
    "recent_acceptance_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "recent_duplicate_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "recent_best_improvement": {"type": "number"}
  },
  "x-canonical-encoding": "UTF-8 JSON, sorted keys, no NaN or Infinity"
}
