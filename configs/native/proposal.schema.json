{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutation-forge.invalid/schemas/native-proposal.v1.json",
  "title": "Mutation Forge native proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "k", "operator_family", "selector_tags", "broken_witnesses", "removed_load", "new_edge_distance", "local_risk"],
  "properties": {
    "schema_version": {"const": "mforge.native.proposal.v1"},
    "k": {"type": "integer", "enum": [2, 3, 4]},
    "operator_family": {"type": "string", "enum": ["legal_2_switch", "legal_3_switch", "legal_4_switch"]},
    "selector_tags": {"type": "array", "items": {"type": "string"}, "maxItems": 8, "uniqueItems": true},
    "broken_witnesses": {"type": "array", "items": {"type": "integer", "minimum": 0}, "maxItems": 16},
    "removed_load": {"type": "array", "items": {"type": "integer", "minimum": 0}, "maxItems": 16},
    "new_edge_distance": {"type": "number", "minimum": 0},
    "local_risk": {"type": "number", "minimum": 0}
  },
  "x-authority": "The host supplies legal proposals and never exposes post-rewrite scores."
}
