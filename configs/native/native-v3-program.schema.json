{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutation-forge.invalid/schemas/native-v3-program.json",
  "title": "Mutation Forge Native v3 mutation program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry"],
  "properties": {
    "schema_version": {"type": "string", "const": "mforge.native.program.v3"},
    "entry": {"$ref": "#/$defs/node"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "expression": {
      "oneOf": [
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "boolean"},
        {"type": "string", "pattern": "^[ -~]*$"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name"],
          "properties": {
            "op": {"const": "ref"},
            "name": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field"],
          "properties": {
            "op": {"enum": ["ctx", "feature"]},
            "field": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "numerator", "denominator"],
          "properties": {
            "op": {"const": "rational"},
            "numerator": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
            "denominator": {"type": "integer", "minimum": 1, "maximum": 4294967295}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "selector_id", "arguments"],
          "properties": {
            "op": {"const": "selector"},
            "selector_id": {"$ref": "#/$defs/identifier"},
            "arguments": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/expression"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "source", "mode"],
          "properties": {
            "op": {"const": "pick"},
            "source": {"$ref": "#/$defs/expression"},
            "mode": {"enum": ["seeded_uniform", "seeded_weighted", "require_singleton"]},
            "weight_feature": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "left", "right"],
          "properties": {
            "op": {"enum": ["add", "subtract", "multiply", "minimum", "maximum", "equal", "less", "less_equal", "greater", "greater_equal", "and", "or"]},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": {"enum": ["not", "exists"]},
            "value": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "children"],
          "properties": {
            "op": {"const": "block"},
            "children": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/node"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "name", "value", "body"],
          "properties": {
            "op": {"const": "let"},
            "name": {"$ref": "#/$defs/identifier"},
            "value": {"$ref": "#/$defs/expression"},
            "body": {"$ref": "#/$defs/node"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "condition", "then", "else"],
          "properties": {
            "op": {"const": "if"},
            "condition": {"$ref": "#/$defs/expression"},
            "then": {"$ref": "#/$defs/node"},
            "else": {"$ref": "#/$defs/node"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "branches"],
          "properties": {
            "op": {"const": "try"},
            "branches": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/node"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "count", "body"],
          "properties": {
            "op": {"const": "repeat"},
            "count": {"type": "integer", "minimum": 1, "maximum": 8},
            "body": {"$ref": "#/$defs/node"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "branches"],
          "properties": {
            "op": {"const": "choose"},
            "branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["weight", "body"],
                "properties": {
                  "weight": {"type": "integer", "minimum": 1, "maximum": 4294967295},
                  "body": {"$ref": "#/$defs/node"}
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "action_id", "arguments"],
          "properties": {
            "op": {"const": "apply"},
            "action_id": {"$ref": "#/$defs/identifier"},
            "arguments": {
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/expression"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {"op": {"const": "emit"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "reason"],
          "properties": {
            "op": {"const": "no_plan"},
            "reason": {"enum": ["EXPLICIT", "NO_MATCH", "ILLEGAL_FINAL_STATE", "NO_EFFECT"]}
          }
        }
      ]
    }
  }
}
