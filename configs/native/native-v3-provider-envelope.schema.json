{
  "$id": "mforge.native-v3-provider-envelope.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native v3 program carried by the Native v2 provider envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "design_summary",
    "hypothesis",
    "used_fields",
    "assumptions",
    "expected_failure_modes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mforge.native.generated_policy.v1"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12288,
      "description": "One strict JSON mforge.native.program.v3 document."
    },
    "design_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "used_fields": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    },
    "expected_failure_modes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    }
  }
}
