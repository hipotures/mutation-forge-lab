{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutation-forge.invalid/schemas/stage3-config.v1.json",
  "title": "Stage 3 generation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "model", "limits", "resources", "evaluation", "experiment", "inputs", "repositories", "identity"],
  "properties": {
    "schema_version": {"const": "stage3.1"},
    "run": {"type": "object", "additionalProperties": false, "required": ["run_root"], "properties": {"run_root": {"type": "string", "minLength": 1}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["name", "effort", "slots", "max_repairs"], "properties": {"name": {"const": "gpt-5.6-luna"}, "effort": {"const": "high"}, "slots": {"const": ["slot-00", "slot-01", "slot-02", "slot-03", "slot-04", "slot-05", "slot-06", "slot-07"]}, "max_repairs": {"const": 1}}},
    "limits": {"type": "object", "additionalProperties": false, "required": ["resource_address_space_bytes", "resource_cpu_seconds", "resource_file_bytes", "resource_open_files", "resource_processes", "request_bytes", "response_bytes", "event_bytes", "transcript_bytes", "stdout_bytes", "stderr_bytes", "turn_seconds", "campaign_seconds"], "properties": {"resource_address_space_bytes": {"type": "integer", "exclusiveMinimum": 0}, "resource_cpu_seconds": {"type": "number", "exclusiveMinimum": 0}, "resource_file_bytes": {"type": "integer", "exclusiveMinimum": 0}, "resource_open_files": {"type": "integer", "exclusiveMinimum": 0}, "resource_processes": {"type": "integer", "exclusiveMinimum": 0}, "request_bytes": {"type": "integer", "exclusiveMinimum": 0}, "response_bytes": {"type": "integer", "exclusiveMinimum": 0}, "event_bytes": {"type": "integer", "exclusiveMinimum": 0}, "transcript_bytes": {"type": "integer", "exclusiveMinimum": 0}, "stdout_bytes": {"type": "integer", "exclusiveMinimum": 0}, "stderr_bytes": {"type": "integer", "exclusiveMinimum": 0}, "turn_seconds": {"type": "number", "exclusiveMinimum": 0}, "campaign_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["max_generation_workers", "max_evaluation_workers", "reserved_physical_cores", "thread_count"], "properties": {"max_generation_workers": {"const": 8}, "max_evaluation_workers": {"const": 8}, "reserved_physical_cores": {"const": 8}, "thread_count": {"const": 1}}},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["bootstrap_samples", "bootstrap_seed", "confidence_level", "random_relative_threshold", "structural_fraction_threshold"], "properties": {"bootstrap_samples": {"type": "integer", "exclusiveMinimum": 0}, "bootstrap_seed": {"type": "integer", "exclusiveMinimum": 0}, "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "random_relative_threshold": {"const": 0.05}, "structural_fraction_threshold": {"const": 0.90}}},
    "experiment": {"type": "object", "additionalProperties": false, "required": ["orders", "graph_seeds", "policy_seeds", "horizon", "shard_count", "episodes_per_shard"], "properties": {"orders": {"const": [10, 12]}, "graph_seeds": {"const": [301, 302, 303, 304]}, "policy_seeds": {"const": [3001, 3002, 3003, 3004, 3005, 3006, 3007, 3008, 3009, 3010, 3011, 3012, 3013, 3014, 3015, 3016]}, "horizon": {"const": 32}, "shard_count": {"const": 8}, "episodes_per_shard": {"const": 16}}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["stage2b_config", "random_policy", "structural_policy", "manifest", "context_schema", "proposal_schema", "slot_briefs_dir", "system_prompt", "request_prompt", "output_schema"], "properties": {"stage2b_config": {"type": "string"}, "random_policy": {"type": "string"}, "structural_policy": {"type": "string"}, "manifest": {"type": "string"}, "context_schema": {"type": "string"}, "proposal_schema": {"type": "string"}, "slot_briefs_dir": {"type": "string"}, "system_prompt": {"type": "string"}, "request_prompt": {"type": "string"}, "output_schema": {"type": "string"}}},
    "repositories": {"type": "object", "additionalProperties": false, "required": ["project_repo", "heg_repo", "frozen_project_commit", "frozen_heg_commit", "preregistration_tag"], "properties": {"project_repo": {"type": "string"}, "heg_repo": {"type": "string"}, "frozen_project_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "frozen_heg_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "preregistration_tag": {"type": "string", "minLength": 1}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["context_schema_sha256", "proposal_schema_sha256", "freeze_payload_sha256", "manifest_sha256", "system_prompt_sha256", "request_prompt_sha256", "output_schema_sha256"], "properties": {"context_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "proposal_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "freeze_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "system_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "request_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "output_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
