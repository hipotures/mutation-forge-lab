{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 5 generalization manifest",
  "type": "object",
  "required": ["schema_version", "held_out", "orders", "graph_seeds", "relabeling_seeds", "policy_seeds", "horizon", "episode_count", "shard_count", "episodes_per_shard", "episodes", "shards", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "stage5.generalization.manifest.v1"},
    "held_out": {"const": true},
    "orders": {"const": [14, 18, 22]},
    "graph_seeds": {"type": "array", "minItems": 16, "maxItems": 16},
    "relabeling_seeds": {"const": [6101, 6102]},
    "policy_seeds": {"type": "array", "minItems": 16, "maxItems": 16},
    "horizon": {"const": 32},
    "episode_count": {"const": 1536},
    "shard_count": {"const": 24},
    "episodes_per_shard": {"const": 64},
    "episodes": {"type": "array", "minItems": 1536, "maxItems": 1536},
    "shards": {"type": "array", "minItems": 24, "maxItems": 24},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
