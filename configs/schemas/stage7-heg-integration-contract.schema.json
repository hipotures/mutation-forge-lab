    "activation": {"type": "object", "required": ["default_enabled", "reviewed_id_only", "explicit_lane_parameter_required", "silent_resume_activation"]},
    "determinism": {"type": "object", "required": ["validator_version", "runtime_protocol_version", "feature_contract_version", "proposal_pool_contract_version", "tie_breaking_rule", "failure_policy", "resume_requires_exact_identity"]},
