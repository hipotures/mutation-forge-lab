      "properties": {
        "catalog_id": {"const": "mutation_forge_stage4r_v1"},
        "policy_id": {"const": "program-d5ad1c8203e0d9f25f03aabd"},
        "source_sha256": {"const": "e444562c1b308e3b23cb732be5f769ea1923ac1809501cea8571318c4aff0a7b"},
        "normalized_ast_sha256": {"const": "2243214df58c805e9a9343dc31ed082279e1c2ac31b21243bf889dbc9a19e165"},
        "behavior_signature_sha256": {"const": "8c2bdaa213f11b253d3ffcae1653bd01536879bb5c254a1586ded9ae522a868e"},
