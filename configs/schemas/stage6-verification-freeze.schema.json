    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage5_evidence_manifest_sha256": {"type": "string", "const": "e996563c145ac12bc7e7ae9bb284ae98d14a2990aaac9bce17e9992486780cce"},
    "policy_ids": {"type": "array", "minItems": 4, "maxItems": 4},
    "experiment": {"type": "object"},
    "resources": {"type": "object"},
    "bootstrap": {"type": "object"},
    "gates": {"type": "object"},
    "freeze_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
