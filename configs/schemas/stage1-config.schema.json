{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutation-forge.local/schemas/stage1-config.schema.json",
  "title": "Mutation Forge Stage 1 configuration",
  "type": "object",
  "required": ["schema_version", "run", "heg", "dataset", "score", "search", "proposals"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run": {
      "type": "object",
      "required": ["seed", "wall_seconds", "output", "run_root"],
      "properties": {
        "seed": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "output": {"enum": ["rich", "json"]},
        "run_root": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "heg": {
      "type": "object",
      "required": ["repo"],
      "properties": {
        "repo": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["orders", "graph_seeds", "policy_seeds", "split"],
      "properties": {
        "orders": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 4, "multipleOf": 2}
        },
        "graph_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "policy_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "split": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["witness_cap"],
      "properties": {
        "witness_cap": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "required": [
        "controller",
        "evaluations_per_episode",
        "proposal_pool_size"
      ],
      "properties": {
        "controller": {"const": "fixed_ils_tabu"},
        "evaluations_per_episode": {"type": "integer", "minimum": 1},
        "proposal_pool_size": {"type": "integer", "minimum": 1},
        "profiling_enabled": {"type": "boolean", "default": true},
        "deep_profiling_enabled": {"type": "boolean", "default": false},
        "score_cache_enabled": {"type": "boolean", "default": true},
        "score_cutoff_enabled": {"type": "boolean", "default": true},
        "prepared_graph_cache_enabled": {"type": "boolean", "default": true},
        "prepared_proposal_handoff_enabled": {"type": "boolean", "default": true},
        "score_longest_first_enabled": {"type": "boolean", "default": true},
        "score_compact_dominated_enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "proposals": {
      "type": "object",
      "required": ["operator_families", "k_values"],
      "properties": {
        "operator_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "heg_uniform_two_switch",
              "heg_forbidden_cycle_break"
            ]
          }
        },
        "k_values": {
          "type": "array",
          "const": [2]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
